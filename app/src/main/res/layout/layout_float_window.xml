<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/floatHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖼️ 图片悬浮窗"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/floatCloseBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="✕"
                android:textColor="#888888"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/floatConfigText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="分辨率: 1920x1080 | 旋转: 0°"
            android:textColor="#666666"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/floatStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:text="未选择图片"
            android:textColor="#1976D2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/floatSelectBtn"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="#1976D2"
            android:padding="0dp"
            android:text="选择多张图片"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/floatNextBtn"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:backgroundTint="#2E7D32"
            android:padding="0dp"
            android:text="下一个图片"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
